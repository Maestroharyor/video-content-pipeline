# dependencies / OS
node_modules/
.DS_Store

# downloaded caches (re-fetched by `npm run assets` / `npm run transcribe`)
assets/.cache/

# the original reference deck: keep its source, drop its renders
generated/**/*.mp4
generated/**/*.gif
generated/**/*.zip

# per-project build products (posters + contact sheet ARE committed so reviews are reproducible)
# `**` so variant folders (renders/<variant>/final), nested projects (cloud-vs-devops/social) and social cuts match too
projects/**/frames/
projects/**/renders/**/gif/
projects/**/renders/**/mp4/
projects/**/renders/**/webm/
projects/**/renders/**/final/
projects/**/renders/**/strip/
projects/**/renders/**/.cache.json
projects/**/renders/social/
projects/**/renders/beats/
projects/**/renders/audio-ab/
# npm run deliver: links to the finished renders (masters, cuts, image posts), rebuilt by every finishing command
projects/**/deliver/
projects/**/.whisper/
# generated by `npm run sfx` (can run to ~100 MB), rebuilt from timeline beats
projects/**/assets/sfx.wav

# voiceover recordings (vo.json + transcript.txt stay in git; the audio itself is too big)
projects/**/vo.wav
projects/**/vo.m4a
projects/**/vo.mp3
projects/**/vo.flac
projects/**/vo.ogg
projects/**/vo-original.*
# repaired / alternate takes of a voiceover
projects/*/audio-fix/*.wav

# A-roll footage that overlay variants composite onto (npm run assemble -- --over / PROJECT.overlay.video)
projects/**/aroll.*

# Project folders are per-video work (recordings, transcripts, renders, links into ~/Downloads): kept out of git.
# The exceptions are what the engine, the tests and the skill depend on. The build-product rules above still apply
# inside them.
projects/*
# test fixtures (test/pipeline + test/projects load template-gallery; test/dual plans ai-in-every-app-reveal,
# whose slides/assets/vo are symlinks into ai-in-every-app and ai-in-every-app-overlay)
!projects/template-gallery/
!projects/ai-in-every-app/
!projects/ai-in-every-app-overlay/
!projects/ai-in-every-app-reveal/
# the channel's intro stings and end screen: the source decks the spliced clips are rendered from
!projects/lifetechfacts-intro*/
!projects/lifetechfacts-endscreen/
# reference decks the new-video skill points to
!projects/aws-forgotten-resources/
!projects/cloud-vs-devops/

# machine-local working notes (absolute paths into ~/Downloads)
/PLAN.md

# react-to-solid: the verification apps' Vite builds
projects/*/code/*/dist/

# stray top-level render output (renders belong under projects/<slug>/renders)
/renders/

# Python bytecode (scripts/*.py imported by each other)
__pycache__/
*.pyc
